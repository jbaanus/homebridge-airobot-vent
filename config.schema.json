{
  "pluginAlias": "AirobotVentilation",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["ipAddress"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Airobot Ventilation"
      },
      "ipAddress": {
        "title": "IP Address",
        "type": "string",
        "format": "ipv4",
        "placeholder": "192.168.1.50",
        "description": "IP address of the Airobot ventilation unit. Modbus TCP must be enabled on the unit."
      }
    }
  }
}
